# ==============================================================================
# RxDecoder Backend Environment Configuration (Example Template)
# ==============================================================================

# Gemini API Key (Required for live multi-agent AI extraction & clinical parsing)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Gemini Model for Vision & Multimodal Agentic Tasks
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Multi-Agent Extraction Temperature (Low value for factual medical accuracy)
APP_ENV=local
TEMPERATURE=0.1
MAX_UPLOAD_SIZE_MB=20

# Server Settings
HOST=0.0.0.0
PORT=8000

# Google client libraries use Application Default Credentials (ADC).
# Local: run `gcloud auth application-default login`.
# Cloud Run: attach a service account; do not set GOOGLE_APPLICATION_CREDENTIALS.
GCP_PROJECT_ID=rxdecoded
GOOGLE_CLOUD_PROJECT=rxdecoded
GCP_SERVICE_ACCOUNT=rxdecoder-sa@rxdecoded.iam.gserviceaccount.com
RAW_PRESCRIPTIONS_BUCKET=raw-prescriptions
SANITIZED_PRESCRIPTIONS_BUCKET=sanitized-prescriptions
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=your_processor_id
ENABLE_GCS_STORAGE=true
ALLOWED_ORIGINS=http://localhost:5173
